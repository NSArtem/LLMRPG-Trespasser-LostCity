    {
      "id": "class.level-0-peasants",
      "record_type": "class",
      "fields": {
        "title": "Level 0 Peasants",
        "text": "The game begins with 12 level 0 peasants in a dungeon. Unless there are more than 6 players, each player controls multiple peasants. Each player chooses one controlled peasant as their PC; the remaining controlled peasants are hirelings."
      },
      "source_pages": [
        5
      ],
      "confidence": "high",
      "references": [
        "rule.level-0-ability-score-generation",
        "rule.checks-and-saves",
        "table.level-0-peasant-base-stats",
        "table.peasant-demographic",
        "table.peasant-appearance",
        "table.peasant-personality",
        "class.peasant-profession"
      ],
      "uncertainties": []
    },
    {
      "id": "rule.level-0-ability-score-generation",
      "record_type": "rule",
      "fields": {
        "title": "Level 0 Ability Score Generation",
        "text": "Generate Str, Dex, Con, Int, Wis, and Cha randomly in order. For each score, roll 3d6, divide the result by two, and round down. The average score is 5. The source states that there are four other stats."
      },
      "source_pages": [
        5
      ],
      "confidence": "high",
      "references": [
        "class.level-0-peasants",
        "table.level-0-peasant-base-stats"
      ],
      "uncertainties": []
    },
    {
      "id": "rule.checks-and-saves",
      "record_type": "rule",
      "fields": {
        "title": "Checks and Saves",
        "text": "Nearly all checks are against DC 16: roll a d20, add the relevant stat, and meet or exceed the DC. Saves are an exception and use Dex, Con, or Cha against DC 20. Cha is used for all magical effects and is the most common Save."
      },
      "source_pages": [
        5
      ],
      "confidence": "high",
      "references": [
        "class.level-0-peasants"
      ],
      "uncertainties": []
    },
    {
      "id": "rule.small-stature",
      "record_type": "rule",
      "fields": {
        "title": "Small Stature",
        "text": "A child has Small Stature. Switch Str with the character's lowest ability score. Cramped spaces impose no penalty. The character does not have a Profession."
      },
      "source_pages": [
        5
      ],
      "confidence": "high",
      "references": [
