# Системные и редакторские файлы
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python и локальные окружения
__pycache__/
*.pyc
.venv/
venv/
.env

# Локальные неприменённые checkpoint-пакеты.
inbox/*
!inbox/PUT_CHECKPOINT_HERE

# Крупные и потенциально защищённые исходные материалы.
